{
  "name": "herd",
  "version": "0.0.12-beta",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "herd": "./herd-cli.mjs"
  },
  "scripts": {
    "generate:provider-registry": "node ./modules/agents/providers/generate-registry.mjs",
    "docs:check": "tsx tools/check-docs.ts",
    "db:ready": "tsx tools/db-ready.ts",
    "store:ready": "tsx tools/store-ready.ts",
    "migrate:sqlite": "tsx tools/migrate-sqlite.ts",
    "migrate:provider-secrets": "tsx tools/migrate-provider-secrets.ts",
    "migrate:machine-env-files": "tsx tools/migrate-machine-env-files.ts",
    "migrate:legacy-automations": "tsx tools/migrate-legacy-automations.ts",
    "build:deps": "pnpm run generate:provider-registry && pnpm --filter @gehirn/ai-services build && pnpm --filter @gehirn/herd-cli build && pnpm --filter @gehirn/auth-providers build && pnpm --filter @gehirn/telemetry build && pnpm --filter @gehirn/sse-streaming build && pnpm --filter @gehirn/transcription build",
    "dev": "pnpm run build:deps && concurrently \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "PORT=${PORT:-20009} tsx watch server/index.ts",
    "start": "node dist-server/server/index.js",
    "start:src": "tsx server/index.ts",
    "build": "pnpm run build:deps && vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "NODE_ENV=development pnpm run build:deps && NODE_ENV=development vitest run",
    "lint": "tsx tools/check-agent-session-name-prefixes.ts && eslint src server modules --ext .ts,.tsx",
    "onboard": "herd onboard",
    "cap:sync": "cap sync ios",
    "cap:ios": "cap open ios",
    "cap:build": "pnpm build && cap sync ios"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "@auth0/auth0-react": "^2.4.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@gehirn/ai-services": "workspace:*",
    "@gehirn/auth-providers": "workspace:*",
    "@gehirn/herd-cli": "workspace:*",
    "@gehirn/sse-streaming": "workspace:*",
    "@gehirn/telemetry": "workspace:*",
    "@gehirn/transcription": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.3",
    "@pixi/react": "^8.0.5",
    "@tanstack/react-query": "^5.62.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "gsap": "^3.15.0",
    "imapflow": "^1.3.3",
    "jose": "^5.10.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.8",
    "multer": "1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pixi.js": "^8.16.0",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@gehirn/tsconfig": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "jsdom": "^20.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.0.6",
    "vitest": "^2.1.0"
  }
}
