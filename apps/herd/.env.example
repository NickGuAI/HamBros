PORT=20001
# Optional host/interface binding for the API listener.
# Set this to 127.0.0.1 when Caddy owns the public shell and proxies only API routes.
# HERD_HOST=127.0.0.1
HERD_ALLOWED_ORIGINS=http://localhost:5173
# One-time first-boot key for hosted installs. Use at least 32 bytes. Herd
# persists only its hash, never writes the plaintext key to a server file, and
# will not seed it into a non-fresh keystore. HERD_BOOTSTRAP_MASTER_KEY is an
# equivalent public alias. Remove this variable after creating a permanent key.
# HERD_BOOTSTRAP_MASTER_KEY=
# Max concurrent agent sessions (default 10). New sessions return 429 when limit reached.
# HERD_MAX_AGENT_SESSIONS=20
# Provider process placement. `host-or-daemon` permits local, SSH, and daemon
# execution. `daemon-only` keeps this server as a control plane and requires a
# connected, provider-ready daemon. HERD_PROVIDER_EXECUTION_MODE is an
# equivalent public alias.
# HERD_PROVIDER_EXECUTION_MODE=host-or-daemon
# For Capacitor iOS app (bundled mode): add capacitor://localhost to allow CORS
# Example: http://localhost:5173,https://herd.gehirn.ai,capacitor://localhost
# Internal API key for Command Room server-side session creation.
# Must include the agents:write scope.
HERD_INTERNAL_API_KEY=
# Optional Auth0 configuration. Leave commented out to use the built-in API key sign-in flow.
# AUTH0_DOMAIN=
# AUTH0_AUDIENCE=
# AUTH0_CLIENT_ID=
# VITE_AUTH0_DOMAIN=
# VITE_AUTH0_AUDIENCE=
# VITE_AUTH0_CLIENT_ID=
# Optional: GitHub Personal Access Token for Commander task fetching.
# Required if taskSource repos are private. Needs repo:read scope.
# GITHUB_TOKEN=
# Optional: Vercel integration for Service Manager.
# Team-level token with access to list projects/deployments and trigger deploys.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Root data directory for all Herd runtime data.
# Defaults to ~/.herd when unset. All modules store data under this root.
# HERD_DATA_DIR=${HOME}/.herd
# Module-level override for commander data (sessions.json, names.json, <id>/.memory, <id>/skills).
# Defaults to <HERD_DATA_DIR>/commander when unset.
# COMMANDER_DATA_DIR=${HOME}/.herd/commander
# Optional machine identifier for machine-scoped S3 sync prefix.
# Defaults to HOSTNAME.
# COMMANDER_MACHINE_ID=my-machine
# Optional S3 durability controls.
# COMMANDER_S3_BUCKET=my-s3-bucket
# COMMANDER_S3_PREFIX=commander
# COMMANDER_S3_SYNC_ENABLED=1
# Optional: when set, used to encrypt sensitive settings (e.g. OpenAI transcription key).
# If unset, Herd auto-generates a local key file at data/api-keys/transcription-secrets.key.
# HERD_SETTINGS_ENCRYPTION_KEY=
